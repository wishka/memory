# Скопируйте в .env и заполните. .env в репозиторий не попадает (.gitignore).

# Пароль базы: любая длинная случайная строка, например из
#   openssl rand -base64 24
DB_PASSWORD=

# Как сервер виден снаружи: funnel (Tailscale, бесплатно) или caddy (свой домен)
COMPOSE_PROFILES=funnel

# ── funnel ───────────────────────────────────────────────────────────
# Ключ: https://login.tailscale.com/admin/settings/keys → Generate auth key
# (нужен только при первом запуске; дальше вход хранится в томе tailscale)
TS_AUTHKEY=
# Имя машины → адрес https://memory.<ваша-сеть>.ts.net
TS_HOSTNAME=memory

# ── caddy ────────────────────────────────────────────────────────────
# Домен, A-запись которого указывает на IP этого сервера
DOMAIN=

# Память для сервера (Java). На машине с 1 ГБ — оставьте как есть
JAVA_OPTS=-Xmx384m
